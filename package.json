  "description": "BCH BLAZE 2026 — ClaimForge Merkle claims on Bitcoin Cash",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @bchblaze/identity build && pnpm --filter @bchblaze/claimforge dev",
